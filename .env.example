# Do'kon uchun ALOHIDA bot tokeni (@BotFather -> /newbot). Tokenni faqat .env ga yozing!
BOT_TOKEN=bu_yerga_token

# Buyurtmalar keladigan admin(lar) Telegram ID'si (botga /id yozib bilib oling). Vergul bilan ajrating.
ADMIN_IDS=123456789

# Mini App manzili (GitHub Pages)
WEBAPP_URL=https://nodirbek5298.github.io/clothing-shop-bot/

# Kartaga o'tkazma uchun rekvizitlar (mijozga ko'rsatiladi)
CARD_NUMBER=
CARD_HOLDER=

# Avtomatik Excel hisobot adminlarga (Toshkent vaqti). Bo'sh qoldirsangiz, avtomatik yuborilmaydi.
# Kunlik: har kuni shu vaqtda. Haftalik: kun (mon, tue, wed, thu, fri, sat, sun) va vaqt.
DAILY_REPORT_AT=21:00
WEEKLY_REPORT_AT=mon 09:00
